<?xml version="1.0" encoding="utf-8"?>
<!--
  启动窗口背景：在 Compose 首帧渲染出来之前的这几秒里，
  让用户看到品牌底 + 瓶中小狮子，而不是一片无信息的空白。

  这里用位图而不是矢量：我们的 logo 是生成的位图（瓶子 + 星星，见
  screen_docs/素材/品牌logo/）。五档密度都放了同一张图的对应尺寸，
  2026-11 换成「瓶中睡着的小狮子」，取自开机动画首帧并以画面中心对称裁切；
  在 800x1280 的板子上与开机视频首帧逐像素同位，冷启动 → 自检 → 开机动画瓶子不跳位。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/launch_logo"
        android:gravity="center" />
</layer-list>
