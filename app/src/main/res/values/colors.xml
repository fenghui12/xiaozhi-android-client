<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 冷启动时系统先画窗口背景、Compose 首帧要 4~5 秒才出来。
         这段时间原本是一片没有任何信息的浅色空窗，测试者直接理解成死机。 -->
    <color name="launch_background">#F1F5FA</color>

    <!-- 自适应图标底色。
         选这个浅蓝而不是纯白或品牌蓝，是实测比较过的：
         瓶身内部是白的，用纯白底就只剩一圈描边、读不出「瓶子」这个形状；
         用品牌蓝底则蓝色描边糊进背景；只有浅蓝底能让白瓶身成为独立形状。 -->
    <color name="ic_launcher_background">#DCE8FF</color>
</resources>
